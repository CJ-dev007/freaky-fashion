<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
   
</head>
<body>

    <header class="top-bar">
        <h1>Administration</h1>
    </header>
    
    <div class="container">
        <!-- Sidomeny -->
         <nav class="sidebar">
            <ul>
                <li class="selected"><a href="/admin/products">Produkter</a></li>
                <li><a href="/admin/categories">Kategorier</a></li>
            </ul>
         </nav>

         <main class="admin-panel">
            <h2>Ny produkt</h2>

            <!-- enctype krävs för att kunna ladda upp filer (bilder) -->
            <form action="/admin/products/new" method="POST" enctype="multipart/form-data">
                
                <div class="form-group">
                    <label for="name">Namn</label>
                    <input type="text" id="name" name="name" placeholder="Ange namn" required maxlength="25">
                    <small>Obligatoriskt, max 25 tecken.</small>
                </div>

                <div class="form-group">
                    <label for="description">Beskrivning</label>
                    <textarea name="description" id="description" rows="5" placeholder="Ange beskrivning"></textarea>
                </div>

                <div class="form-group">
                    <label>Bild</label>
                    <label for="image-upload" class="custom-file-upload">
                    Välj bild
                    </label>
                    <input id="image-upload" type="file" name="image" accept="image/*">
                </div>
                
                <div class="form-group">
                    <label for="brand">Märke</label>
                    <input type="text" id="brand" name="brand" placeholder="Ange märke" required>
                </div>

                <div class="form-group">
                    <label for="sku">SKU</label>
                    <!-- Validering: 3 bokstäver + 3 siffror en -->
                    <input type="text" id="sku" name="sku" placeholder="Ange SKU" required 
                           pattern="[A-Z]{3}[0-9]{3}" 
                           title="Formatet ska vara XXXYYY (t.ex. ABC123)">
                </div>

                <div class="form-group">
                    <label for="price">Pris</label>
                    <input type="number" id="price" name="price" placeholder="Ange pris" required>
                </div>

                <div class="form-group">
                    <label for="createdAt">Publiceringsdatum</label>
                    <input type="date" id="createdAt" name="createdAt">
                </div>

                <div class="form-group">
                    <label for="categoryId">Kategori</label>
                    <select name="categoryId" id="categoryID" required>
                        <option value="">Välj kategori</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                        <% }); %>
                    </select>
                </div>   
                <button type="submit" class="btn-add">Lägg till</button>
            </form>
         </main>
    </div>
</body>
</html>
