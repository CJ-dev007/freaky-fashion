<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
  <header class="top-bar">
        <h1>Administration</h1>
    </header>
    
    <div class="container">
        <!-- Sidomeny -->
         <nav class="sidebar">
            <ul>
                <li class="selected"><a href="/admin/products">Produkter</a></li>
                <li><a href="/admin/categories">Kategorier</a></li>
            </ul>
         </nav>

        <main class="admin-panel">
            <header class="panel-header">
                <h2 class="panel-title">Produkter</h2>
                <a href="/admin/products/new" class="btn-add">Ny produkt</a>
            </header>

            <div class="product-table">
                <div class="table-header">
                    <div class="column-name">Namn</div>
                    <div class="column-sku">SKU</div>
                    <div class="column-price">Pris</div>
                    <div class="column-actions"></div> 
                </div>

                <!-- Loopa igenom produkter från databasen -->
                <% products.forEach(product => { %>
                <div class="table-row">
                    <div><%= product.name %></div>
                    <div><%= product.sku %></div>
                    <div><%= product.price %> kr</div>
                    <div class="action-icons">
                                          
                        <!-- Form för att radera (behövs för att skicka POST) -->
                        <form action="/admin/products/delete/<%= product.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Är du säker på att du vill radera <%= product.name %>?')">
                            <button type="submit" class="icon-link delete-icon" style="background:none; border:none; padding:0; cursor:pointer;">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <% }); %>

                <% if (products.length === 0) { %>
                    <div class="table-row">
                        <div style="grid-column: span 4; text-align: center; padding: 20px;">Inga produkter hittades.</div>
                    </div>
                <% } %>
            </div>   
        </main>
    </div>  
</body>
</html>