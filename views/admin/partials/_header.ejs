<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>
<body>

    <header class="top-bar">
        <h1>Administration</h1>
    </header>
    
    <div class="container">        
         <nav class="sidebar">
            <ul>
                <li class="<%= activePage === 'products' ? 'selected' : '' %>">
                    <a href="/admin/products">Produkter</a></li>
                <li class="<%= activePage === 'categories' ? 'selected' : '' %>">
                    <a href="/admin/categories">Kategorier</a></li>
            </ul>

            <% if (locals.isLoggedIn) { %>
                <div class="user-box">
                    <span class="user-status">Inloggad som: <strong><%= user.username %></strong></span>
                    <a href="/logout" class="logout-link">Logga ut</a>
                </div>
            <% } else { %>
                <div class="user-box">
                    <a href="/login">Logga in</a>
                </div>
            <% } %>
         </nav>

     