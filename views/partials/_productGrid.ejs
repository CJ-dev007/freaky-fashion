<section class="product-grid">
    <h2>Populära produkter</h2>
    <div class="items">
        <% products.forEach(product => { %>
            <div class="product-card">
                <a href="/products/<%= product.slug %>">
                    <div class="image-container">
                        <% 
                            // 1. Räkna ut skillnaden i dagar mellan nu och när produkten skapades
                            const today = new Date();
                            const createdDate = new Date(product.createdAt);
                            const diffInDays = (today - createdDate) / (1000 * 60 * 60 * 24);
                        %>

                        <% if (product.createdAt && diffInDays < 7) { %>
                            <span class="badge">Nyhet</span>
                        <% } %>
                        <img src="/<%= product.image %>" alt="<%= product.name %>">
                        
                        <!-- Logik för hjärtat (fyllt eller tomt) -->
                        <button class="favorite-btn" data-id="<%= product.id %>">
                            <i class="bi <%= product.isFavorite ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                        </button>
                    </div>
                    
                    <div class="product-details-toprow">
                        <div class="name"><%= product.name %></div>
                        <div class="price"><%= product.price %> SEK</div>
                    </div>
                    <div class="brand"><%= product.brand %></div>
                </a>
            </div>
        <% }) %>
    </div>
</section>

