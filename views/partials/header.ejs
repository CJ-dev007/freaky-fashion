<% if (locals.welcomeMessage) { %>
    <div class="alert-success">
        <%= welcomeMessage %>
    </div>
<% } %>

<header class="site-header">
  <div> <!-- Logo -->
    <a href="/">
      <img src="/images/logoFreakyF.png" alt="Logotype" class="logo-placeholder">
    </a>
  </div>

  <div class="top-row">
    <form class="search" action="/search" method="GET"> <!-- Sök -->
      <input type="text" name="q" placeholder="🔍 Sök produkt">
    </form>

    <ul class="icons">
      <li><a href="/favorites" aria-label="Favoriter"><i class="bi bi-heart-fill"></i></a></li>
      <li><a href="/basket" aria-label="Varukorg"><i class="bi bi-basket2-fill"></i></a></li>

      <% if (locals.isLoggedIn) { %>
        <li><a href="/logout" title="Logga ut"><i class="fa-solid fa-right-from-bracket"></i></a></li>
      <% } else { %>
        <li><a href="/login" title="Logga in"><i class="fa-solid fa-right-to-bracket"></i></a></li>
      <% } %>
    </ul>
  </div>

  <nav>
    <ul class="main-menu">
      <li><a href="/news">Nyheter</a></li>

    <% menuCategories.forEach(cat => { %>
      <li>
        <% if (cat.name.toLowerCase() === 'accessoarer') { %>
          <a href="/funny/accessories"><%= cat.name %></a>
        <% } else if (cat.name.toLowerCase() === 'skor') { %>
          <a href="/funny/shoes"><%= cat.name %></a>
        <% } else if (cat.name.toLowerCase() === 'kläder') { %>
          <a href="/categories/klader"><%= cat.name %></a>
        <% } else { %>           
          <a href="/categories/<%= cat.id %>"><%= cat.name %></a>
        <% } %>
      </li>
    <% }); %>
    </ul>
  </nav>
</header>
