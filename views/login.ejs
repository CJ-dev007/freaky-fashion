<%- include('partials/head') %> 
<%- include('partials/header') %>

<div class="login-container">
    <div class="login-box">
        <h1>Logga in</h1>
               
        <% if (locals.errorMessage) { %>
            <div class="error-message" style="color: red; margin-bottom: 1rem;">
                <%= errorMessage %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="login-form">
            <div class="form-group">
                <label for="username">Användarnamn</label>
                <input type="text" id="username" name="username" placeholder="Skriv ditt användarnamn" class="login-input" required>
            </div>

            <div class="form-group">
                <label for="password">Lösenord</label>
                <input type="password" id="password" name="password" placeholder="Skriv ditt lösenord" class="login-input" required>
            </div>

            <button type="submit" class="login-button">Logga in</button>
        </form>

        <p class="auth-switch">Saknar du konto? <a href="/register">Registrera dig här</a></p>

        <a href="/" class="back-link">Tillbaka till shoppen</a>
    </div>
</div>

<%- include('partials/_features.ejs') %>
<%- include('partials/footer') %>